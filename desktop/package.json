{
  "name": "sintonia-desktop",
  "productName": "Sintonia",
  "version": "1.8.0",
  "description": "Leitor de listas M3U (versão desktop do Sintonia)",
  "author": "Nuno Silva",
  "homepage": "https://github.com/Qwerty-PT/sintonia",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:mac": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "hls.js": "1.5.17",
    "sax": "1.4.1",
    "shaka-player": "4.12.6",
    "xz-decompress": "0.2.2"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "pt.nuno.sintonia.desktop",
    "productName": "Sintonia",
    "artifactName": "Sintonia-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.entertainment",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "maintainer": "Nuno Silva"
    }
  }
}
