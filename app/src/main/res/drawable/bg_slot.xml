<?xml version="1.0" encoding="utf-8"?>
<!-- Moldura da janela do vídeo quando focada (centro transparente: o vídeo vê-se por baixo) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@android:color/transparent" />
            <stroke android:width="4dp" android:color="@color/accent" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#333D8BFF" />
            <stroke android:width="4dp" android:color="@color/accent" />
        </shape>
    </item>
    <item><color android:color="@android:color/transparent" /></item>
</selector>
