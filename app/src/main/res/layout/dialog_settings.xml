<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/playlist_url"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://…/lista.m3u"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/epg_url"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/epgUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://…/guia.xml.gz"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnGroups"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/visible_groups_btn" />

        <CheckBox
            android:id="@+id/autoplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/autoplay_last" />

        <CheckBox
            android:id="@+id/autoPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auto_preview" />

        <CheckBox
            android:id="@+id/autoUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auto_update" />

        <Button
            android:id="@+id/btnCheckUpdates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/check_updates" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/about"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.6"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
