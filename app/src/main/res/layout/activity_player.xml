<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:auto_show="false"
        app:resize_mode="fit"
        app:show_buffering="always"
        app:show_shuffle_button="false"
        app:show_subtitle_button="true" />

    <ImageView
        android:id="@+id/radioLogo"
        android:layout_width="260dp"
        android:layout_height="180dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="24dp"
        android:background="@drawable/bg_overlay"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/infoName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/infoMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/epgBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/epgNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="620dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/epgRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/epgProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="180dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="10dp"
                    android:max="1000"
                    android:progressTint="@color/accent" />
            </LinearLayout>

            <TextView
                android:id="@+id/epgDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxWidth="620dp"
                android:maxLines="2"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/epgNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxWidth="620dp"
                android:singleLine="true"
                android:textColor="@color/text_dim"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="32dp"
        android:background="@drawable/bg_overlay"
        android:gravity="center"
        android:padding="20dp"
        android:textColor="@color/text"
        android:textSize="17sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/zap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="20dp"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/zapUp"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="@string/next_channel"
            android:src="@drawable/ic_up" />

        <ImageButton
            android:id="@+id/zapDown"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="@string/prev_channel"
            android:src="@drawable/ic_down" />
    </LinearLayout>
    <!-- Lista de canais sobre o vídeo; o vídeo encolhe para o espaço "videoSlot" (transparente) -->
    <LinearLayout
        android:id="@+id/channelsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_h"
        android:paddingTop="@dimen/page_v"
        android:paddingEnd="@dimen/page_h"
        android:paddingBottom="@dimen/page_v"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.56"
            android:background="@drawable/bg_panel"
            android:orientation="horizontal"
            android:padding="6dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ovGroups"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.38"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:scrollbars="none" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ovChannels"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="0.62"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:scrollbars="vertical" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_weight="0.44"
            android:orientation="vertical">

            <View
                android:id="@+id/videoSlot"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@drawable/bg_slot"
                android:clickable="true"
                android:contentDescription="@string/fullscreen"
                android:focusable="true" />

            <include
                layout="@layout/view_guide"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
